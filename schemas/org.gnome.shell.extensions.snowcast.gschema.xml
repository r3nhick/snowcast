<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.snowcast" path="/org/gnome/shell/extensions/snowcast/">
    <key name="enabled" type="b">
      <default>true</default>
      <summary>Snowfall enabled</summary>
    </key>
    <key name="intensity" type="i">
      <range min="5" max="100"/>
      <default>50</default>
      <summary>Snowfall intensity</summary>
    </key>
    <key name="wind-angle" type="i">
      <range min="-75" max="75"/>
      <default>0</default>
      <summary>Snow direction: angle from vertical (negative — left, positive — right)</summary>
    </key>
    <key name="wind-gusts" type="b">
      <default>true</default>
      <summary>Wind gusts</summary>
    </key>
    <key name="max-snow" type="i">
      <range min="10" max="80"/>
      <default>40</default>
      <summary>Maximum snowdrift height at the bottom of the screen (px)</summary>
    </key>
    <key name="window-snow" type="b">
      <default>true</default>
      <summary>Snow sticks to the top edges of windows</summary>
    </key>
    <key name="window-radius" type="i">
      <range min="0" max="40"/>
      <default>16</default>
      <summary>Window corner radius (px)</summary>
    </key>
    <key name="shake-off" type="b">
      <default>true</default>
      <summary>Snow slides off when a window moves sharply</summary>
    </key>
    <key name="plow-enabled" type="b">
      <default>true</default>
      <summary>Snowplow</summary>
    </key>
    <key name="plow-interval" type="i">
      <range min="10" max="300"/>
      <default>40</default>
      <summary>How often the snowplow comes (seconds)</summary>
    </key>
    <key name="cursor-clear" type="b">
      <default>true</default>
      <summary>Melt snow with the cursor</summary>
    </key>
    <key name="hide-on-fullscreen" type="b">
      <default>true</default>
      <summary>Hide snow when a fullscreen window is active</summary>
    </key>
    <key name="frame-rate" type="i">
      <range min="15" max="60"/>
      <default>30</default>
      <summary>Frames per second</summary>
    </key>
    <key name="show-indicator" type="b">
      <default>true</default>
      <summary>Show the icon in the top bar</summary>
    </key>
  </schema>
</schemalist>
