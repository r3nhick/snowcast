# Ukrainian translation for Snowcast
msgid ""
msgstr ""
"Project-Id-Version: snowcast\n"
"Language: uk\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "Snowfall"
msgstr "Снігопад"

msgid "Snow on windows"
msgstr "Сніг на вікнах"

msgid "Snowplow"
msgstr "Машинка-снігоприбиральник"

msgid "Melt snow with the cursor"
msgstr "Топити сніг курсором"

msgid "🚜  Call the snowplow"
msgstr "🚜  Викликати машинку"

msgid "🧹  Clear all snow"
msgstr "🧹  Прибрати весь сніг"

msgid "🌬  Snow direction…"
msgstr "🌬  Напрямок снігу…"

msgid "Settings…"
msgstr "Налаштування…"

msgid "Snow direction"
msgstr "Напрямок снігу"

msgid "Drag the arrow with the mouse or move the slider"
msgstr "Потягніть стрілку мишкою або рухайте повзунок"

msgid "Snow angle"
msgstr "Кут снігу"

msgid "↓  Straight down"
msgstr "↓  Прямо вниз"

msgid "↙  %d° to the left"
msgstr "↙  %d° вліво"

msgid "↘  %d° to the right"
msgstr "↘  %d° вправо"

msgid "🌬  Wind gusts: on"
msgstr "🌬  Пориви вітру: увімкнено"

msgid "🌬  Wind gusts: off"
msgstr "🌬  Пориви вітру: вимкнено"

msgid "No wind"
msgstr "Без вітру"

msgid "Done"
msgstr "Готово"

msgid "Log out and back in to load the new settings."
msgstr "Вийдіть із сеансу й увійдіть знову, щоб з’явилися нові налаштування."

msgid "Snowcast %s is out"
msgstr "Вийшов Snowcast %s"

msgid "Open Settings → About to see how to update."
msgstr "Відкрийте Налаштування → Про розширення, щоб дізнатися, як оновити."

msgid "Open Settings"
msgstr "Відкрити налаштування"

msgid "❄️ Snowfall"
msgstr "❄️ Снігопад"

msgid "Enable Snowcast"
msgstr "Увімкнути Snowcast"

msgid "Turns everything off without disabling the extension"
msgstr "Вимикає все, не вимикаючи саме розширення"

msgid "When off, no new snow falls, but the settled snow stays"
msgstr "Якщо вимкнути, новий сніг не падає, а той, що вже лежить, лишається"

msgid "Intensity"
msgstr "Інтенсивність"

msgid "How many snowflakes fall at once"
msgstr "Скільки сніжинок падає одночасно"

msgid "Snowdrift height"
msgstr "Висота кучугур"

msgid "Maximum snow height at the bottom of the screen, px"
msgstr "Максимальна висота снігу внизу екрана, px"

msgid "Snow sticks to the top edges of windows"
msgstr "Сніг налипає на верхні краї вікон"

msgid "Window corner radius"
msgstr "Заокруглення кутів вікон"

msgid "Snow doesn’t settle on rounded corners. Increase it if snow “hangs” over a corner"
msgstr "Сніг не лягає на заокруглені кути. Збільште, якщо сніг «висить» над кутом"

msgid "Snow inertia"
msgstr "Інерція снігу"

msgid "Snow slides when a window moves sharply and falls off the edge"
msgstr "Сніг ковзає при різкому русі вікна й падає з краю"

msgid "🌬 Wind"
msgstr "🌬 Вітер"

msgid "You can also set it with the mouse: snowflake icon → “Snow direction…”"
msgstr "Те саме можна задати мишкою: значок сніжинки → «Напрямок снігу…»"

msgid "Angle from vertical: minus — left, plus — right"
msgstr "Кут від вертикалі: мінус — вліво, плюс — вправо"

msgid "Wind gusts"
msgstr "Пориви вітру"

msgid "Snow drifts sideways, sometimes stronger, sometimes weaker"
msgstr "Сніг то сильніше, то слабше зносить убік"

msgid "🚜 Clearing"
msgstr "🚜 Прибирання"

msgid "Drives along the bottom of the screen from time to time"
msgstr "Час від часу проїжджає внизу екрана"

msgid "Snowplow interval"
msgstr "Інтервал машинки"

msgid "Seconds between runs"
msgstr "Секунд між проїздами"

msgid "The cursor melts snow, and steam rises above it"
msgstr "Курсор розтоплює сніг, над ним піднімається пара"

msgid "Other"
msgstr "Інше"

msgid "Hide falling snow over the active window"
msgstr "Не показувати сніг над активним вікном"

msgid "Snow falls behind the window you are working in; the snow on its top edge stays"
msgstr "Сніг падає позаду вікна, в якому ви працюєте; сніг на його верхньому краї лишається"

msgid "Hide in fullscreen"
msgstr "Ховати в повноекранному режимі"

msgid "Doesn’t get in the way of videos and games"
msgstr "Не заважає відео та іграм"

msgid "Frames per second"
msgstr "Кадрів на секунду"

msgid "Lower is easier on the CPU"
msgstr "Менше — легше для процесора"

msgid "Icon in the top bar"
msgstr "Значок на верхній панелі"

msgid "Settings"
msgstr "Налаштування"

msgid "About"
msgstr "Про розширення"

msgid "Version %s"
msgstr "Версія %s"

msgid "Website"
msgstr "Сайт"

msgid "Features, installing and updating"
msgstr "Можливості, встановлення та оновлення"

msgid "Report a problem"
msgstr "Повідомити про проблему"

msgid "On GitHub; paste the report below in it"
msgstr "На GitHub; вставте в нього звіт нижче"

msgid "Copy a bug report"
msgstr "Скопіювати звіт про помилку"

msgid "Versions, system and changed settings, ready to paste into a report"
msgstr "Версії, система й змінені налаштування — готово, щоб вставити у звіт"

msgid "Copied — paste it into the report on GitHub"
msgstr "Скопійовано — вставте у звіт на GitHub"

msgid "License"
msgstr "Ліцензія"

msgid "GNU General Public License, version 3 or later"
msgstr "GNU General Public License, версія 3 або новіша"

msgid "Reset all settings"
msgstr "Скинути всі налаштування"

msgid "Back to the defaults"
msgstr "Повернути типові значення"

msgid "Reset all settings?"
msgstr "Скинути всі налаштування?"

msgid "Every option goes back to its default."
msgstr "Усі параметри повернуться до типових значень."

msgid "Cancel"
msgstr "Скасувати"

msgid "Reset"
msgstr "Скинути"

msgid "Download"
msgstr "Завантажити"

msgid "Update"
msgstr "Оновити"

msgid "Log Out"
msgstr "Вийти"

msgid "Try Again"
msgstr "Спробувати ще"

msgid "Check for new versions"
msgstr "Перевіряти нові версії"

msgid "Asks GitHub once a day; nothing else is sent"
msgstr "Раз на день питає GitHub; більше нічого не надсилається"

msgid "Updating to Snowcast %s…"
msgstr "Оновлення до Snowcast %s…"

msgid "Downloading from GitHub"
msgstr "Завантаження з GitHub"

msgid "Couldn’t update"
msgstr "Не вдалося оновити"

msgid "Snowcast %s is installed"
msgstr "Snowcast %s встановлено"

msgid "Log out and back in to finish"
msgstr "Вийдіть із сеансу й увійдіть знову, щоб завершити"

msgid "Not checking for new versions"
msgstr "Нові версії не перевіряються"

msgid "Turn it on below to hear when one is out"
msgstr "Увімкніть нижче, щоб дізнатися, коли вийде нова"

msgid "Your snow and settings stay"
msgstr "Ваш сніг і налаштування лишаться"

msgid "Download it from GitHub"
msgstr "Завантажте його з GitHub"

msgid "You’re up to date"
msgstr "У вас остання версія"

msgid "Checked %s"
msgstr "Перевірено %s"

msgid "Not checked yet"
msgstr "Ще не перевірялося"

msgid "Snowcast asks GitHub once a day"
msgstr "Snowcast питає GitHub раз на день"

msgid "today"
msgstr "сьогодні"

msgid "yesterday"
msgstr "вчора"

msgid "This copy has local changes; git didn’t overwrite them. Commit or stash them, or download instead"
msgstr "У цій копії є локальні зміни; git їх не перезаписав. Закомітьте чи сховайте їх (stash) або завантажте оновлення вручну"

msgid "GitHub couldn’t be reached; try again later"
msgstr "Не вдалося зв’язатися з GitHub; спробуйте пізніше"

msgid "git pull failed"
msgstr "git pull не вдався"

msgid "This copy already matches GitHub; nothing new was downloaded. Check metadata.json for local edits"
msgstr "Ця копія вже збігається з GitHub; нічого нового не завантажено. Перевірте, чи не змінювали metadata.json"

msgid "git finished, but the version on disk didn’t change"
msgstr "git завершився, але версія на диску не змінилася"
