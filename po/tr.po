# Turkish translation for Snowcast
msgid ""
msgstr ""
"Project-Id-Version: snowcast\n"
"Language: tr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Snowfall"
msgstr "Kar yağışı"

msgid "Snow on windows"
msgstr "Pencerelerde kar"

msgid "Snowplow"
msgstr "Kar küreme aracı"

msgid "Melt snow with the cursor"
msgstr "İmleçle karı erit"

msgid "🚜  Call the snowplow"
msgstr "🚜  Kar küreme aracını çağır"

msgid "🧹  Clear all snow"
msgstr "🧹  Tüm karı temizle"

msgid "🌬  Snow direction…"
msgstr "🌬  Kar yönü…"

msgid "Settings…"
msgstr "Ayarlar…"

msgid "Snow direction"
msgstr "Kar yönü"

msgid "Drag the arrow with the mouse or move the slider"
msgstr "Oku fareyle sürükleyin veya kaydırıcıyı hareket ettirin"

msgid "Snow angle"
msgstr "Kar açısı"

msgid "↓  Straight down"
msgstr "↓  Dümdüz aşağı"

msgid "↙  %d° to the left"
msgstr "↙  %d° sola"

msgid "↘  %d° to the right"
msgstr "↘  %d° sağa"

msgid "🌬  Wind gusts: on"
msgstr "🌬  Rüzgâr esintileri: açık"

msgid "🌬  Wind gusts: off"
msgstr "🌬  Rüzgâr esintileri: kapalı"

msgid "No wind"
msgstr "Rüzgârsız"

msgid "Done"
msgstr "Tamam"

msgid "Log out and back in to load the new settings."
msgstr "Yeni ayarların yüklenmesi için oturumu kapatıp yeniden açın."

msgid "Snowcast %s is out"
msgstr "Snowcast %s çıktı"

msgid "Open Settings → About to see how to update."
msgstr "Nasıl güncelleneceğini görmek için Ayarlar → Hakkında bölümünü açın."

msgid "Open Settings"
msgstr "Ayarları aç"

msgid "❄️ Snowfall"
msgstr "❄️ Kar yağışı"

msgid "Enable Snowcast"
msgstr "Snowcast'i etkinleştir"

msgid "Turns everything off without disabling the extension"
msgstr "Uzantıyı devre dışı bırakmadan her şeyi kapatır"

msgid "When off, no new snow falls, but the settled snow stays"
msgstr "Kapalıyken yeni kar yağmaz, ancak birikmiş kar yerinde kalır"

msgid "Intensity"
msgstr "Yoğunluk"

msgid "How many snowflakes fall at once"
msgstr "Aynı anda kaç kar tanesi düşer"

msgid "Snowdrift height"
msgstr "Kar yığını yüksekliği"

msgid "Maximum snow height at the bottom of the screen, px"
msgstr "Ekranın altındaki en fazla kar yüksekliği, px"

msgid "Snow sticks to the top edges of windows"
msgstr "Kar pencerelerin üst kenarlarına yapışır"

msgid "Window corner radius"
msgstr "Pencere köşe yarıçapı"

msgid "Snow doesn’t settle on rounded corners. Increase it if snow “hangs” over a corner"
msgstr "Kar yuvarlatılmış köşelere yerleşmez. Kar bir köşenin üzerinde “asılı” kalıyorsa artırın"

msgid "Snow inertia"
msgstr "Kar ataleti"

msgid "Snow slides when a window moves sharply and falls off the edge"
msgstr "Pencere aniden hareket ettiğinde kar kayar ve kenardan düşer"

msgid "🌬 Wind"
msgstr "🌬 Rüzgâr"

msgid "You can also set it with the mouse: snowflake icon → “Snow direction…”"
msgstr "Bunu fareyle de ayarlayabilirsiniz: kar tanesi simgesi → “Kar yönü…”"

msgid "Angle from vertical: minus — left, plus — right"
msgstr "Dikeyden açı: eksi — sola, artı — sağa"

msgid "Wind gusts"
msgstr "Rüzgâr esintileri"

msgid "Snow drifts sideways, sometimes stronger, sometimes weaker"
msgstr "Kar bazen daha güçlü, bazen daha zayıf şekilde yana savrulur"

msgid "🚜 Clearing"
msgstr "🚜 Temizleme"

msgid "Drives along the bottom of the screen from time to time"
msgstr "Zaman zaman ekranın altından geçer"

msgid "Snowplow interval"
msgstr "Kar küreme aracı aralığı"

msgid "Seconds between runs"
msgstr "Geçişler arası saniye"

msgid "The cursor melts snow, and steam rises above it"
msgstr "İmleç karı eritir ve üzerinden buhar yükselir"

msgid "Other"
msgstr "Diğer"

msgid "Hide falling snow over the active window"
msgstr "Etkin pencerenin üzerinde kar gösterme"

msgid "Snow falls behind the window you are working in; the snow on its top edge stays"
msgstr "Kar, üzerinde çalıştığınız pencerenin arkasına yağar; üst kenarındaki kar yerinde kalır"

msgid "Hide in fullscreen"
msgstr "Tam ekranda gizle"

msgid "Doesn’t get in the way of videos and games"
msgstr "Videolara ve oyunlara engel olmaz"

msgid "Frames per second"
msgstr "Saniyedeki kare sayısı"

msgid "Lower is easier on the CPU"
msgstr "Daha düşük değer işlemciyi daha az yorar"

msgid "Icon in the top bar"
msgstr "Üst çubukta simge"

msgid "Settings"
msgstr "Ayarlar"

msgid "About"
msgstr "Hakkında"

msgid "Version %s"
msgstr "Sürüm %s"

msgid "Website"
msgstr "Web sitesi"

msgid "Features, installing and updating"
msgstr "Özellikler, kurulum ve güncelleme"

msgid "Report a problem"
msgstr "Sorun bildir"

msgid "On GitHub; paste the report below in it"
msgstr "GitHub'da; aşağıdaki raporu içine yapıştırın"

msgid "Copy a bug report"
msgstr "Hata raporunu kopyala"

msgid "Versions, system and changed settings, ready to paste into a report"
msgstr "Sürümler, sistem ve değiştirilen ayarlar; rapora yapıştırmaya hazır"

msgid "Copied — paste it into the report on GitHub"
msgstr "Kopyalandı — GitHub'daki rapora yapıştırın"

msgid "License"
msgstr "Lisans"

msgid "GNU General Public License, version 3 or later"
msgstr "GNU Genel Kamu Lisansı, sürüm 3 veya üzeri"

msgid "Reset all settings"
msgstr "Tüm ayarları sıfırla"

msgid "Back to the defaults"
msgstr "Varsayılanlara dön"

msgid "Reset all settings?"
msgstr "Tüm ayarlar sıfırlansın mı?"

msgid "Every option goes back to its default."
msgstr "Her seçenek varsayılan değerine döner."

msgid "Cancel"
msgstr "İptal"

msgid "Reset"
msgstr "Sıfırla"

msgid "Download"
msgstr "İndir"

msgid "Update"
msgstr "Güncelle"

msgid "Log Out"
msgstr "Oturumu kapat"

msgid "Try Again"
msgstr "Tekrar dene"

msgid "Check for new versions"
msgstr "Yeni sürümleri denetle"

msgid "Asks GitHub once a day; nothing else is sent"
msgstr "Günde bir kez GitHub'a sorar; başka hiçbir şey gönderilmez"

msgid "Updating to Snowcast %s…"
msgstr "Snowcast %s sürümüne güncelleniyor…"

msgid "Downloading from GitHub"
msgstr "GitHub'dan indiriliyor"

msgid "Couldn’t update"
msgstr "Güncellenemedi"

msgid "Snowcast %s is installed"
msgstr "Snowcast %s yüklendi"

msgid "Log out and back in to finish"
msgstr "Bitirmek için oturumu kapatıp yeniden açın"

msgid "Not checking for new versions"
msgstr "Yeni sürümler denetlenmiyor"

msgid "Turn it on below to hear when one is out"
msgstr "Yeni sürüm çıktığında haberdar olmak için aşağıdan açın"

msgid "Your snow and settings stay"
msgstr "Karınız ve ayarlarınız korunur"

msgid "Download it from GitHub"
msgstr "GitHub'dan indirin"

msgid "You’re up to date"
msgstr "Güncelsiniz"

msgid "Checked %s"
msgstr "Denetlendi: %s"

msgid "Not checked yet"
msgstr "Henüz denetlenmedi"

msgid "Snowcast asks GitHub once a day"
msgstr "Snowcast günde bir kez GitHub'a sorar"

msgid "today"
msgstr "bugün"

msgid "yesterday"
msgstr "dün"

msgid "This copy has local changes; git didn’t overwrite them. Commit or stash them, or download instead"
msgstr "Bu kopyada yerel değişiklikler var; git bunların üzerine yazmadı. Bunları commit edin veya stash yapın ya da elle indirin"

msgid "GitHub couldn’t be reached; try again later"
msgstr "GitHub'a ulaşılamadı; daha sonra tekrar deneyin"

msgid "git pull failed"
msgstr "git pull başarısız oldu"

msgid "This copy already matches GitHub; nothing new was downloaded. Check metadata.json for local edits"
msgstr "Bu kopya zaten GitHub ile aynı; yeni bir şey indirilmedi. metadata.json'da yerel değişiklik olup olmadığını kontrol edin"

msgid "git finished, but the version on disk didn’t change"
msgstr "git tamamlandı, ancak diskteki sürüm değişmedi"
